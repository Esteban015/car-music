{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "durable_objects": {
    "bindings": [
      {
        "name": "MUSIC_GUARD",
        "class_name": "MusicGuard"
      }
    ]
  },

  "exports": {
    "MusicGuard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

    "secrets": {
        "required": [
            "SPOTIFY_CLIENT_ID",
            "SPOTIFY_CLIENT_SECRET",
            "SPOTIFY_REFRESH_TOKEN",
            "ADMIN_PASSWORD"
        ]
    }
}